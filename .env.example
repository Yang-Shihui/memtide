# Memtide deployment configuration — copy to .env and fill in.
# NOTE: .env is gitignored; never commit real keys.

# --- REST service ---------------------------------------------------------
MEMTIDE_PORT=8300

# --- PostgreSQL (relational storage) ----------------------------------------
POSTGRES_USER=memtide
POSTGRES_PASSWORD=change-me
POSTGRES_DB=memtide
MEMTIDE_PG_DSN=postgresql://memtide:change-me@localhost:5432/memtide

# --- Qdrant (vector store) ---------------------------------------------------
MEMTIDE_QDRANT_COLLECTION=memtide

# --- LLM (any OpenAI-compatible endpoint) ------------------------------------
LLM_BACKEND=openai
LLM_BASE_URL=http://your-llm-endpoint/v1
LLM_MODEL=your-model
LLM_API_KEY=sk-xxx

# --- Embeddings (DashScope) ---------------------------------------------------
EMBEDDING_BACKEND=dashscope
DASHSCOPE_API_KEY=sk-xxx
